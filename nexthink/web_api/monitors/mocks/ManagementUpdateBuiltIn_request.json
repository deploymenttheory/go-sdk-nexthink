{
  "query": "mutation UpdateBuiltInMonitor(\n\t\t$docUuid: String!\n\t\t$revision: Int!\n\t\t$monitor: NqlMonitorInput!\n\t) {\n\t\tupdateBuiltInMonitor(\n\t\t\tdocUuid: $docUuid\n\t\t\trevision: $revision\n\t\t\tmonitor: $monitor\n\t\t)\n\t}\n",
  "operationName": "UpdateBuiltInMonitor",
  "variables": {
    "docUuid": "fixture-id",
    "revision": 1,
    "monitor": {
      "name": "Fixture monitor",
      "nqlId": "#fixture_monitor",
      "description": "Synthetic fixture",
      "priority": "LOW",
      "tags": [],
      "notifications": [],
      "emailConfiguration": {
        "carbonCopies": [],
        "recipients": [],
        "subject": "",
        "content": "",
        "notificationScope": "BOTH"
      },
      "origin": "CUSTOM",
      "monitorType": "METRIC",
      "metricType": "NQL_GENERIC_METRIC",
      "pollingPeriodMillis": 604800000,
      "nqlQuery": "devices | summarize count = count()",
      "nqlStoreUuid": "",
      "updateNqlQuery": false,
      "triggerConditionList": [
        {
          "name": "count",
          "label": "Count",
          "dataType": "integer",
          "metricComparator": "GT_OR_EQ",
          "staticThreshold": {
            "threshold": 1000000000,
            "unit": null
          },
          "changeThreshold": null,
          "timeOfDayThreshold": null
        }
      ],
      "filterConditionList": [],
      "groupByList": [],
      "autoRecoveryMode": "IMMEDIATE",
      "evaluationWindowSeconds": null,
      "uuid": "fixture-monitor"
    }
  }
}
